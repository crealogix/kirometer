          "rawSql": "SELECT user_label AS \"User\",\n       string_agg(DISTINCT subscription_tier, ', ' ORDER BY subscription_tier) AS \"Subscription\",\n       string_agg(DISTINCT client_type, ', ' ORDER BY client_type) AS \"Type\",\n       sum(credits_used) AS \"Credits\",\n       sum(total_messages) AS \"Messages\",\n       sum(chat_conversations) AS \"Conversations\",\n       sum(overage_credits_used) AS \"Overage Credits\",\n       max(overage_cap) AS \"Overage Cap\",\n       bool_or(overage_enabled) AS \"Overage Enabled\",\n       -- Latest limit, not the maximum: a mid-month tier change must not\n       -- leave the old limit in place.\n       (array_agg(usage_limit ORDER BY usage_date DESC)\n            FILTER (WHERE usage_limit IS NOT NULL))[1] AS \"Usage Limit\",\n       round(100 * sum(credits_used)\n             / NULLIF((array_agg(usage_limit ORDER BY usage_date DESC)\n                       FILTER (WHERE usage_limit IS NOT NULL))[1], 0), 1) AS \"Usage %\",\n       count(DISTINCT usage_date) AS \"Active Days\"\nFROM v_usage_daily\nWHERE $__timeFilter(usage_date)\n  AND client_type IN (${client_type:sqlstring})\n  AND user_label IN (${user:sqlstring})\n  AND subscription_tier IN (${subscription:sqlstring})\nGROUP BY 1\nORDER BY \"Usage %\" DESC NULLS LAST, 4 DESC"
        }
      ]
    }
  ]
}
